# Email (Resend). Without these the contact and subscribe forms say email isn't set up.
RESEND_API_KEY=
# Resend > Audience > Segments: the segment that holds confirmed subscribers.
RESEND_SEGMENT_ID=
# Must be on a domain verified in Resend.
EMAIL_FROM="Mujibul Haque Tanim <hello@mujibulhaquetanim.dev>"
# Where contact-form messages go. Defaults to site.email.
EMAIL_TO=info@mujibulhaquetanim.dev

# Signs the double opt-in links. At least 32 random characters: openssl rand -base64 48
SUBSCRIBE_SECRET=
# Bearer token for POST /api/notify. Also a GitHub repository secret of the same name.
NOTIFY_SECRET=
